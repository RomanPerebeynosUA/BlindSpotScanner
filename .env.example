# Copy to .env and change the values. Never commit .env.
POSTGRES_USER=blindspot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=blindspot

# Claude API key (D20). Leave empty to build and test with fakes; the opt-in live test also
# needs BSS_LIVE_REPO_URL (a small public ASP.NET Core repo). Calls are billed.
ANTHROPIC_API_KEY=

# GitHub personal access token for private repositories (D16). Optional for public ones.
GITHUB_TOKEN=

# Jira Cloud (D24), optional: "Create Jira" on the report needs all four. The API token comes from
# https://id.atlassian.com/manage-profile/security/api-tokens.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Where the web app is reachable; ticket descriptions link back to the report here.
APP_PUBLIC_URL=http://localhost:8080

# Fix pull requests (D25): "Fix with PR" opens draft PRs with GITHUB_TOKEN, which then needs
# contents:write and pull_requests:write. Set to false for read-only mode (the button is hidden).
FEATURES_PULL_REQUESTS=true

# Sign-in (D26). Local = everyone is the built-in local admin. Oidc = sign in with any OpenID
# Connect provider; register https://<host>/api/auth/callback as its redirect URI.
AUTH_MODE=Local
AUTH_AUTHORITY=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_ROLE_CLAIM=roles

# OpenTelemetry: traces and metrics are exported over OTLP only when this is set.
OTEL_EXPORTER_OTLP_ENDPOINT=
