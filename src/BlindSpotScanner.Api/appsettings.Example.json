  "//": "Doc 10's configuration shape. Copy what you need into environment variables (Section__Key) or .env; never put real secret values in a committed file.",
  "Auth": {
    "Mode": "Local",
    "Authority": "",
    "ClientId": "",
    "ClientSecret": "",
