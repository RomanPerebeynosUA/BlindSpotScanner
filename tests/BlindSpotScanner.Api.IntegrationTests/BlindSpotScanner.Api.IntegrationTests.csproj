<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- As in Infrastructure.Tests: WireMock.Net's Handlebars helpers pin Humanizer 2.14.1 while JsonSchema.Net
         needs Humanizer.Core 3.x. WireMock's templating is never used. Test project only. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="WireMock.Net.Minimal" Version="2.31.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlindSpotScanner.Api\BlindSpotScanner.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\fixtures\bookstore\**\*" LinkBase="fixtures\bookstore" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\BlindSpotScanner-Blueprint\examples\*.json" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
