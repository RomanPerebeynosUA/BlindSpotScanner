<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- WireMock.Net's Handlebars helpers pin Humanizer 2.14.1 locale packages while JsonSchema.Net needs
         Humanizer.Core 3.x. We never use WireMock's Humanizer templating, so the constraint mismatch is
         harmless here. Test project only; product projects keep NU1608 as an error. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\BlindSpotScanner-Blueprint\examples\*.json" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\BlindSpotScanner-Blueprint\contracts\integration-report.schema.json" Link="Fixtures\integration-report.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="GitHub\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="WireMock.Net.Minimal" Version="2.31.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlindSpotScanner.Infrastructure\BlindSpotScanner.Infrastructure.csproj" />
  </ItemGroup>

</Project>
